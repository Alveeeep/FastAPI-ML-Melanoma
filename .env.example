APP_NAME=melanoma-cds-service
APP_VERSION=0.1.0
MODEL_NAME=resnet50v2
MODEL_WEIGHTS_PATH=models/resnet50v2_c5_baseline_best.pt
IMAGE_SIZE=224
DEVICE=cpu
TTA_RUNS=4
SCREENING_THRESHOLD=0.237
HIGH_SPECIFICITY_THRESHOLD=0.2621931731700897
ENABLE_AUTH=false
API_TOKEN=change-me
TELEGRAM_BOT_TOKEN=
API_BASE_URL=http://127.0.0.1:8000
API_MODE=checkpoint
API_TIMEOUT_SECONDS=60
REVIEW_MARGIN=0.05
DATABASE_URL=postgresql+asyncpg://melanoma:melanoma@localhost:5432/melanoma
DATABASE_ECHO=false
